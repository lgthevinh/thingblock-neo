{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ThingBlock Neo",
    "version": "0.0.0",
    "identifier": "com.thingedu.thingblock-neo",
    "build": {
        "devUrl": "http://localhost:5173",
        "frontendDist": "../../packages/gui/dist",
        "beforeDevCommand": "npm run dev -w @thingblock-neo/gui",
        "beforeBuildCommand": "npm run build -w @thingblock-neo/gui"
    },
    "app": {
        "windows": [
            {
                "title": "ThingBlock Neo",
                "width": 1280,
                "height": 800
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
